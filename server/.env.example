GEMINI_API_KEY=...
PORT=4000
DB_PATH=./data/inbox.db
EMBEDDING_MODEL=gemini-embedding-001
LOG_LEVEL=info
# Optional: use NVIDIA NIM for chat answers (embeddings stay on Gemini)
# NVIDIA_API_KEY=nvapi-...

# Include retrieval details (candidates, timings) in query responses
DEBUG=false

# Relevance filter: keep chunks within WINDOW of the best score, or at least HIGH_SCORE
RELEVANCE_WINDOW=0.12
RELEVANCE_HIGH_SCORE=0.6
