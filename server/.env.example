# Required
GEMINI_API_KEY=...

# Server
PORT=4000
DB_PATH=./data/inbox.db
LOG_LEVEL=info

# Models. Embeddings always use Gemini.
EMBEDDING_MODEL=gemini-embedding-001
# Optional: answer with NVIDIA NIM instead of Gemini (falls back to Gemini if the model is retired)
# NVIDIA_API_KEY=nvapi-...
# Optional: override the answer model (default: poolside/laguna-xs-2.1 with NVIDIA, gemini-3.1-flash-lite without)
# CHAT_MODEL=

# Retrieval: vector (default) or hybrid (vector + FTS5 keyword search, fused). HYBRID_FUSION: rrf | weighted
RETRIEVAL_MODE=vector
HYBRID_FUSION=rrf

# Include retrieval details (candidates, timings) in query responses and show them in the UI
DEBUG=false

# Relevance filter: keep chunks within WINDOW of the best score, or at least HIGH_SCORE
RELEVANCE_WINDOW=0.12
RELEVANCE_HIGH_SCORE=0.6

# Scripts only (not read by the server): API_URL for `npm run seed` / `npm run eval` (default http://localhost:4000),
# EVAL_INGEST_URL to also time saving a URL in `npm run eval`.
# Client only (client/.env): VITE_API_URL if the API is not on http://localhost:4000.
