# Required
GEMINI_API_KEY=...

# Server
PORT=4000
DB_PATH=./data/inbox.db
LOG_LEVEL=info

# Which API does what. Pick ONE of three setups (leave the others commented out):
#  1) Default: GEMINI_API_KEY above does everything. Gemini embeds; chat uses NVIDIA if NVIDIA_API_KEY is set, else Gemini.
#  2) One API for both jobs (any OpenAI-compatible service, e.g. OpenRouter or OpenAI): fill the AI_* lines and both model names.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=...
# CHAT_MODEL=...
#  3) Two APIs, one per job (each one falls back to AI_* when its own line is empty):
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_API_KEY=...
# CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
# CHAT_API_KEY=...
# CHAT_MODEL=...
# Inputs per embedding request (default 100; lower it if your embedding API rejects 100)
# EMBEDDING_BATCH=100
# Changing the embedding model needs "npm run reindex" once per database (the server refuses to start until then).

# Models.
EMBEDDING_MODEL=gemini-embedding-001
# Optional: answer with NVIDIA NIM instead of Gemini (falls back to Gemini if the model is retired)
# NVIDIA_API_KEY=nvapi-...
# Optional: override the answer model (default: poolside/laguna-xs-2.1 with NVIDIA, gemini-3.1-flash-lite without)
# CHAT_MODEL=

# Retrieval: hybrid (default: vector + FTS5 keyword search, fused) or vector (cosine only). HYBRID_FUSION: weighted (default) | rrf
RETRIEVAL_MODE=hybrid
HYBRID_FUSION=weighted

# Answer-model timeouts. With both NVIDIA and Gemini keys: no first token within the first value (or a 5xx / connection error) switches once to the other provider. With one provider the first token may take up to the second value.
# LLM_FIRST_TOKEN_TIMEOUT_MS=8000
# LLM_REQUEST_TIMEOUT_MS=30000

# Include retrieval details (candidates, timings) in query responses and show them in the UI
DEBUG=false

# Relevance filter: keep chunks within WINDOW of the best score, or at least HIGH_SCORE
RELEVANCE_WINDOW=0.12
RELEVANCE_HIGH_SCORE=0.6

# Scripts only (not read by the server): API_URL for `npm run seed` / `npm run eval` (default http://localhost:4000),
# EVAL_INGEST_URL to also time saving a URL in `npm run eval`.
# Client only (client/.env): VITE_API_URL if the API is not on http://localhost:4000.
